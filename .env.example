# Mom Transcript Environment Configuration
# Copy this file to .env and modify as needed

# Audio Configuration
PULSE_RUNTIME_PATH=/run/user/1000/pulse
PULSE_NATIVE=1
AUDIO_DEVICE_INDEX=1

# Application Configuration
APP_MODE=batch
LANGUAGE=id
OUTPUT_DIR=./output

# Docker Configuration
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# Resource Limits
MEMORY_LIMIT=2g
CPU_LIMIT=1.0

# Whisper Model Configuration
WHISPER_MODEL=small
MODEL_PATH=./whisper.cpp/models

# Development
DEBUG=false
LOG_LEVEL=INFO